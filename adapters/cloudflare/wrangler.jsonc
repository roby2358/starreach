// Starreach on Cloudflare (D-21): one Worker, one SQLite Durable Object per game holding the
// game and its viewer sockets, one per player holding the player's lifetime totals (D-45), and
// the home page and viewer page as static assets.
// `just cf-dev` runs this locally; `just cf-deploy` deploys the production environment.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "starreach",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-07",
  "workers_dev": false,
  "observability": { "enabled": true },
  // The home page and the viewer page (D-40, D-31). A request that matches a file here is served without running the
  // Worker; /mcp, /health and /live/<view_id> match none, so they reach the Worker.
  // public/.assetsignore keeps instructions.txt out, which the Worker imports as a module.
  "assets": { "directory": "../../public" },
  "durable_objects": {
    "bindings": [
      { "name": "GAMES", "class_name": "GameObject" },
      { "name": "PLAYERS", "class_name": "PlayerObject" }
    ]
  },
  // Migrations are top-level only and apply to every environment. A new class gets a new tag.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameObject"] },
    { "tag": "v2", "new_sqlite_classes": ["PlayerObject"] }
  ],
  // Sign-in for /mcp (D-41): auth/ is the authorization server, reached for its keys
  // through a service binding (a public same-zone fetch returned an edge 522 for jsonsolver).
  // Locally, auth/ runs under `just dev-up` in yuwakisacloud on :8788.
  "services": [{ "binding": "AUTH_SERVICE", "service": "auth" }],
  "vars": {
    "AUTH_ISSUER": "http://localhost:8788",
    // The MCP endpoint's canonical URL, registered as a resource in the local auth/ D1
    "STARREACH_RESOURCE": "http://localhost:8787/mcp",
    // The starreach client row in the local auth/ D1 (auth/cf-d1/seed-local/seed_dev.sql)
    "STARREACH_CLIENT_ID": "D21zauaGSjnD3U77"
  },
  "env": {
    // Deployed with `wrangler deploy --env production`. The route is in this block only, so
    // `wrangler dev` carries none.
    "production": {
      // Without this the Worker would deploy as "starreach-production"
      "name": "starreach",
      "routes": [{ "pattern": "starreach.yuwakisa.com", "custom_domain": true }],
      // Bindings aren't inherited by an environment, so they are repeated here
      "durable_objects": {
        "bindings": [
          { "name": "GAMES", "class_name": "GameObject" },
          { "name": "PLAYERS", "class_name": "PlayerObject" }
        ]
      },
      "services": [{ "binding": "AUTH_SERVICE", "service": "auth" }],
      "vars": {
        "AUTH_ISSUER": "https://auth.yuwakisa.com",
        // The MCP endpoint's canonical URL, registered as a resource in production auth/
        "STARREACH_RESOURCE": "https://starreach.yuwakisa.com/mcp",
        // The starreach client row in production auth/
        "STARREACH_CLIENT_ID": "cZpqWEBNv9M7xQRl"
      }
    }
  }
}
